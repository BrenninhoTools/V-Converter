package = vminiaudio
headers = vminiaudio/VAudio.h
headerFilter = vconverter_none.h
compilerOpts = -std=c11 -O2
---
#define VMA_VORBIS_HEADER_ONLY 1
#include "VAudio.c"
#include "VAudioEngine.c"
#include "VAudioPlayer.c"
#include "VAudioSource.c"
#include "VWaveform.c"
#include "VAudioBus.c"

static inline const char* vca_version(void) {
    return vma_get_version();
}

static inline void* vca_init(int rate, int channels) {
    VMAConfig config;
    vma_config_init(&config);
    config.sample_rate = (uint32_t)rate;
    config.channels = (uint32_t)channels;
    config.enable_logging = false;
    VMAContext* context = NULL;
    return vma_init(&context, &config) == VMA_SUCCESS ? context : NULL;
}

static inline void vca_shutdown(void* context) {
    vma_shutdown((VMAContext*)context);
}

static inline void* vca_add_s16(void* context, const short* samples, int frames, int channels, int rate) {
    VMAAudio* audio = NULL;
    if (frames <= 0 || channels <= 0)
        return NULL;
    return vma_audio_create_pcm((VMAContext*)context, samples, (uint64_t)frames, (uint32_t)channels, (uint32_t)rate, VMA_SAMPLE_S16, &audio) == VMA_SUCCESS ? audio : NULL;
}

static inline int vca_play(void* audio) {
    return (int)vma_audio_play((VMAAudio*)audio);
}

static inline int vca_pause(void* audio) {
    return (int)vma_audio_pause((VMAAudio*)audio);
}

static inline int vca_seek(void* audio, double seconds) {
    return (int)vma_audio_seek((VMAAudio*)audio, seconds);
}

static inline double vca_position(void* audio) {
    return vma_audio_get_position((VMAAudio*)audio);
}

static inline double vca_duration(void* audio) {
    return vma_audio_get_duration((VMAAudio*)audio);
}

static inline int vca_set_volume(void* audio, float volume) {
    return (int)vma_audio_set_volume((VMAAudio*)audio, volume);
}

static inline int vca_set_pitch(void* audio, float pitch) {
    return (int)vma_audio_set_pitch((VMAAudio*)audio, pitch);
}

static inline int vca_set_master_volume(void* context, float volume) {
    return (int)vma_set_master_volume((VMAContext*)context, volume);
}

static inline int vca_render(void* context, float* output, int frames) {
    return frames > 0 ? (int)vma_render((VMAContext*)context, output, (uint32_t)frames) : 0;
}

static inline int vca_set_pan(void* audio, float pan) {
    return (int)vma_audio_set_pan((VMAAudio*)audio, pan);
}

static inline int vca_fade(void* audio, float target, double seconds) {
    return (int)vma_audio_fade((VMAAudio*)audio, target, seconds, VMA_FADE_CONTINUE);
}

static inline int vca_set_bus(void* audio, int bus) {
    return bus < 0 ? (int)VMA_ERROR_INVALID_ARGUMENT : (int)vma_audio_set_bus((VMAAudio*)audio, (uint32_t)bus);
}

static inline int vca_bus_volume(void* context, int bus, float volume) {
    return bus < 0 ? (int)VMA_ERROR_INVALID_ARGUMENT : (int)vma_bus_set_volume((VMAContext*)context, (uint32_t)bus, volume);
}

static inline int vca_bus_filters(void* context, int bus, float lowpass, float highpass) {
    if (bus < 0)
        return (int)VMA_ERROR_INVALID_ARGUMENT;
    int result = (int)vma_bus_set_lowpass((VMAContext*)context, (uint32_t)bus, lowpass);
    return result != 0 ? result : (int)vma_bus_set_highpass((VMAContext*)context, (uint32_t)bus, highpass);
}

static inline int vca_bus_echo(void* context, int bus, float seconds, float feedback, float mix) {
    return bus < 0 ? (int)VMA_ERROR_INVALID_ARGUMENT : (int)vma_bus_set_echo((VMAContext*)context, (uint32_t)bus, seconds, feedback, mix);
}

static inline int vca_set_interpolation(void* context, int mode) {
    return (int)vma_set_interpolation((VMAContext*)context, (VMAInterpolation)mode);
}

static inline int vca_set_limiter(void* context, int enabled, float ceiling) {
    return (int)vma_set_limiter((VMAContext*)context, enabled != 0, ceiling);
}

static inline int vca_meter(void* context, float* out) {
    VMAMeter meter;
    int result = (int)vma_get_meter((const VMAContext*)context, &meter);
    if (result == 0) {
        out[0] = meter.peak_left;
        out[1] = meter.peak_right;
        out[2] = meter.rms_left;
        out[3] = meter.rms_right;
        out[4] = meter.gain_reduction;
    }
    return result;
}

static inline double vca_time(void* context) {
    return vma_get_time((const VMAContext*)context);
}
