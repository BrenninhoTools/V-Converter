import funkin.data.event.SongEventSchema;
import funkin.modding.module.ModuleHandler;
import funkin.play.event.SongEvent;

class __CLASS__ extends SongEvent
{
  public function new()
  {
    super("PsychEvent");
  }

  override public function handleEvent(data:Dynamic):Void
  {
    var runtime:Dynamic = ModuleHandler.getModule("__RUNTIME_ID__");
    if (runtime == null || data == null || data.value == null) return;
    runtime.scriptCall("handleBuiltinEvent", [Reflect.field(data.value, "name"), Reflect.field(data.value, "value1"), Reflect.field(data.value, "value2")]);
  }

  override public function getTitle():String
  {
    return "Psych Event";
  }

  override public function getEventSchema():Dynamic
  {
    return new SongEventSchema([
      {name: "name", title: "Event", type: "string", defaultValue: ""},
      {name: "value1", title: "Value 1", type: "string", defaultValue: ""},
      {name: "value2", title: "Value 2", type: "string", defaultValue: ""}
    ]);
  }
}
